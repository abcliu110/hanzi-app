{
  "group": "补语细分",
  "groupId": "buyu",
  "version": "草稿 v0.1（2026-11-04）",
  "note": "与现有「补语」「趋向补语引申义」两项互补：那两项讲总述和趋向补语，本组把其余五类拆开细讲。术语按刘月华等《实用现代汉语语法》：跑得很快 一类称「状态补语」（有的教材叫程度补语或情态补语），本组「程度补语」专指 极了/得很/坏了 一类。",
  "items": [
    {
      "id": "bu_jieguo",
      "group": "补语细分",
      "title": {
        "term": "结果补语",
        "kid": "做完以后变成什么样"
      },
      "core": "动词后面紧跟一个动词或形容词，说明动作带来的结果：洗干净、看懂、打碎；中间不加“得”，已然的否定用“没”。",
      "tpl": [
        "morph",
        "test",
        "fix",
        "review"
      ],
      "rel": [
        "补语",
        "把字句"
      ],
      "scenes": [
        {
          "lv": 1,
          "k": "morph",
          "tab": "动作前，动作后",
          "say": [
            "杯子好好的。弟弟一碰——杯子打碎了。",
            "“打”是动作，“碎”是结果。动作后面紧跟着结果，就是结果补语。"
          ],
          "ex": [
            {
              "s": "弟弟把杯子打碎了。",
              "ok": true
            }
          ],
          "ask": "“打”了以后，杯子怎么样了？",
          "act": [
            "句子下方两格状态图：杯子完整 → 杯子碎了，停 4 秒",
            "“碎”从上方落到“打”后面，紧贴着不留空",
            "“碎”两侧画尖括号〈〉（补语线）"
          ]
        },
        {
          "lv": 2,
          "k": "cards",
          "tab": "常见的结果",
          "say": [
            "常做结果补语的有：完、好、懂、见、到、住、走、掉、错，还有干净、清楚。",
            "看——看见；听——听懂；写——写错。加上结果，动作就有了着落。"
          ],
          "ex": [
            {
              "s": "我听见有人敲门。",
              "ok": true
            },
            {
              "s": "这道题我看懂了。",
              "ok": true
            },
            {
              "s": "他把名字写错了。",
              "ok": true
            },
            {
              "s": "衣服洗干净了。",
              "ok": true
            }
          ],
          "act": [
            "左列动词卡、右列结果卡，连线配对",
            "每对合成一个词块，结果部分画〈〉",
            "读四个例句"
          ]
        },
        {
          "lv": 2,
          "k": "fix",
          "tab": "否定用“没”",
          "say": [
            "说已经发生的事没有结果，用“没”，不用“不”。",
            "我昨天不写完作业——不对。我昨天没写完作业——对。",
            "注意：说条件时可以用“不”：不写完不许看电视。"
          ],
          "ex": [
            {
              "s": "我昨天不写完作业。",
              "ok": false,
              "fix": "我昨天没写完作业。",
              "why": "已经发生的事，否定结果用“没”。"
            },
            {
              "s": "不写完不许看电视。",
              "ok": true,
              "note": "条件句可以用“不”"
            }
          ],
          "act": [
            "错句出现，停 4 秒→✗，错色圈住“不”",
            "“不”换成“没”→✓",
            "第二句单独出现，旁标“条件”"
          ]
        },
        {
          "lv": 2,
          "k": "fix",
          "tab": "宾语放在哪儿",
          "say": [
            "结果补语和动词贴得很紧，宾语要放在结果后面。",
            "看书完——不对。看完书——对。"
          ],
          "ex": [
            {
              "s": "我看书完了。",
              "ok": false,
              "fix": "我看完书了。",
              "why": "动词和结果补语中间不能插宾语。"
            }
          ],
          "act": [
            "“看｜书｜完”三块，停 4 秒→✗",
            "“完”向左滑，挤到“看”后面，“书”让位到后面",
            "读改正句"
          ]
        },
        {
          "lv": 3,
          "k": "vs",
          "tab": "结果说的是谁",
          "say": [
            "想一想：“我写累了”和“我写错了”，“累”和“错”说的是同一个东西吗？",
            "写累了：累的是“我”。写错了：错的是写的字，是动作做得不对。",
            "再看：衣服洗干净了——干净的是衣服。结果补语在意思上可以挂在主语、宾语或动作本身上，语法学叫“语义指向”。"
          ],
          "ex": [
            {
              "s": "我写累了。",
              "ok": true
            },
            {
              "s": "我写错了。",
              "ok": true
            },
            {
              "s": "衣服洗干净了。",
              "ok": true
            }
          ],
          "ask": "“累”和“错”说的是谁？",
          "src": "陆俭明《现代汉语语法研究教程》（第五版），北京大学出版社 2019，「语义指向分析」章",
          "act": [
            "三句上下排开，停 4 秒",
            "从“累”画箭头回到“我”；从“错”画箭头到“写”；从“干净”画箭头到“衣服”",
            "三支箭头方向不同，旁标“说的是谁”"
          ]
        },
        {
          "lv": 2,
          "k": "review",
          "huilian": true,
          "tab": "改对了吗",
          "say": [
            "题目：想说“衣服已经洗干净了”，有人写成“衣服我洗得干净了”，请改正。",
            "这位同学改成：衣服我洗干净得了。改对了吗？"
          ],
          "task": "想说“衣服已经洗干净了”，改正“衣服我洗得干净了”",
          "answer": "衣服我洗干净得了。",
          "ok": false,
          "good": "衣服我洗干净了。",
          "rule": "说已经得到的结果，用结果补语，动词和结果紧贴，中间不加“得”；加了“得”就成了“能不能洗干净”。",
          "act": [
            "题目卡 + 同学答案卡→✗",
            "错色圈住“得”",
            "“得”淡出，读正确答案；旁边小字：洗得干净 = 能洗干净"
          ]
        }
      ],
      "pitfalls": [
        "结果补语前加“得”就变成可能补语：洗干净 / 洗得干净。",
        "已然否定用“没”：✗我不吃饱 → 我没吃饱。",
        "宾语放在结果补语后面：看完书。"
      ],
      "status": "草稿"
    },
    {
      "id": "bu_keneng",
      "group": "补语细分",
      "title": {
        "term": "可能补语",
        "kid": "能不能做到"
      },
      "core": "在动词和结果补语或趋向补语中间插“得/不”，表示能不能实现：看得见/看不见、搬得动/搬不动；还有“V得了/V不了”。",
      "tpl": [
        "morph",
        "vs",
        "fix",
        "review"
      ],
      "rel": [
        "补语",
        "趋向补语引申义",
        "把字句"
      ],
      "scenes": [
        {
          "lv": 1,
          "k": "test",
          "tab": "能还是不能",
          "say": [
            "黑板上的字很小。坐在前面的同学说：我看得清。坐在后面的同学说：我看不清。",
            "在“看”和“清”中间放一个“得”，就是能；放一个“不”，就是不能。"
          ],
          "ex": [
            {
              "s": "我看得清。",
              "ok": true
            },
            {
              "s": "我看不清。",
              "ok": true
            }
          ],
          "ask": "中间放什么，意思是“能”？",
          "act": [
            "“看清”两块分开，中间留空，停 4 秒",
            "“得”落入→✓（能），“不”落入→（不能）",
            "两块状态卡：字清楚 / 字模糊"
          ]
        },
        {
          "lv": 2,
          "k": "morph",
          "tab": "插进去",
          "say": [
            "结果补语：做完。插“得”：做得完。插“不”：做不完。",
            "趋向补语：上去。插“得”：上得去。插“不”：上不去。",
            "还有一种：V得了、V不了，“了”读 liǎo：这么多菜，我吃不了。"
          ],
          "ex": [
            {
              "s": "作业太多，今天做不完。",
              "ok": true
            },
            {
              "s": "山太陡，我们上不去。",
              "ok": true
            },
            {
              "s": "这么多菜，我吃不了。",
              "ok": true
            }
          ],
          "act": [
            "三组词块“做完 / 上去 / 吃了”依次被撑开",
            "“得/不”从上方落入缝里",
            "“了”上方标拼音 liǎo"
          ]
        },
        {
          "lv": 2,
          "k": "vs",
          "tab": "写得好：两种意思",
          "say": [
            "“他写得好”可以有两种意思：一是能写好，二是写得很好。",
            "分辨：能加“很”的，是在描写样子：写得很好。否定说“写得不好”。",
            "表示能不能的，否定说“写不好”。"
          ],
          "ex": [
            {
              "s": "这个字太难，我写不好。",
              "ok": true,
              "note": "可能补语的否定"
            },
            {
              "s": "他这个字写得不好。",
              "ok": true,
              "note": "状态补语的否定"
            }
          ],
          "act": [
            "上下两行，停 4 秒",
            "上句“不”插在中间；下句“不”跟在“得”后面",
            "两句各配一张卡：能力 / 样子"
          ]
        },
        {
          "lv": 2,
          "k": "fix",
          "tab": "把字句里不用",
          "say": [
            "把字句说的是已经做了、产生了结果的事，可能补语说的是能不能，两个合不到一起。",
            "我把这个箱子搬不动——不对。这个箱子我搬不动——对。"
          ],
          "ex": [
            {
              "s": "我把这个箱子搬不动。",
              "ok": false,
              "fix": "这个箱子我搬不动。",
              "why": "可能补语不能进把字句。"
            }
          ],
          "act": [
            "错句停 4 秒→✗，错色圈住“把”和“不动”",
            "“把”淡出，“这个箱子”整块移到句首",
            "读改正句"
          ]
        },
        {
          "lv": 3,
          "k": "vs",
          "tab": "为什么常说“不”",
          "say": [
            "想一想：“这门课我学不会”和“这门课我学得会”，哪一句平时更常听到？",
            "否定的“学不会”常常单独用；肯定的“学得会”多半出现在回答问题或者反问里：你学得会吗？——学得会。",
            "语法书指出：可能补语的否定式比肯定式常用得多。肯定的意思，平时多用“能”来说：我能学会。"
          ],
          "ex": [
            {
              "s": "这门课我学不会。",
              "ok": true
            },
            {
              "s": "你学得会吗？——学得会。",
              "ok": true
            },
            {
              "s": "我能学会。",
              "ok": true
            }
          ],
          "ask": "哪一句更常听到？",
          "src": "刘月华、潘文娱、故韡《实用现代汉语语法》（增订本），商务印书馆 2001，「可能补语」",
          "act": [
            "两句并列，停 4 秒",
            "否定句旁画一个大对话框（常用），肯定句旁画问答两个小框",
            "第三句“能学会”出现，与“学得会”连线"
          ]
        },
        {
          "lv": 2,
          "k": "review",
          "huilian": true,
          "tab": "改对了吗",
          "say": [
            "题目：改正“这么多作业，我写得不完”。",
            "这位同学改成：这么多作业，我写得没完。改对了吗？"
          ],
          "task": "改正“这么多作业，我写得不完”",
          "answer": "这么多作业，我写得没完。",
          "ok": false,
          "good": "这么多作业，我写不完。",
          "rule": "可能补语的否定：“不”直接插在动词和补语中间，不带“得”。",
          "act": [
            "题目卡 + 同学答案卡→✗，错色圈住“得没”",
            "“得没”淡出，“不”落入",
            "读正确答案"
          ]
        }
      ],
      "pitfalls": [
        "否定式是“V不C”，不是“V得不C”：✗写得不完。",
        "可能补语不进把字句。",
        "“V得好”可能是可能补语，也可能是状态补语，看能不能加“很”、怎样否定。"
      ],
      "status": "草稿"
    },
    {
      "id": "bu_chengdu",
      "group": "补语细分",
      "title": {
        "term": "程度补语",
        "kid": "到什么程度"
      },
      "core": "形容词或心理动词后面加“极了、得很、得多、死了、坏了、透了、得不得了、得要命”等，只说程度高，不描写具体的样子。",
      "tpl": [
        "cards",
        "vs",
        "fix",
        "review"
      ],
      "rel": [
        "补语",
        "形容词",
        "副词"
      ],
      "scenes": [
        {
          "lv": 1,
          "k": "cards",
          "tab": "高兴到什么程度",
          "say": [
            "我很高兴。——高兴。",
            "我高兴极了！——高兴到了顶。",
            "我高兴得不得了！——也是高兴到了顶。“极了”“得不得了”跟在后面，说的是程度。"
          ],
          "ex": [
            {
              "s": "我高兴极了。",
              "ok": true
            },
            {
              "s": "我高兴得不得了。",
              "ok": true
            }
          ],
          "act": [
            "一根温度计形状的竖条，“高兴”放底部",
            "“极了”落到“高兴”后，竖条一下涨到顶",
            "“得不得了”同样涨到顶"
          ]
        },
        {
          "lv": 2,
          "k": "cards",
          "tab": "带“得”和不带“得”",
          "say": [
            "程度补语分两种。不带“得”的：好极了、累坏了、气死了、坏透了。",
            "带“得”的：好得很、热得要命、冷得不得了、贵得多。"
          ],
          "ex": [
            {
              "s": "今天热得要命。",
              "ok": true
            },
            {
              "s": "这件衣服贵得多。",
              "ok": true
            },
            {
              "s": "他累坏了。",
              "ok": true
            },
            {
              "s": "这个主意好极了。",
              "ok": true
            }
          ],
          "act": [
            "两张卡：不带“得” / 带“得”",
            "例句分别落入两张卡",
            "补语部分画〈〉"
          ]
        },
        {
          "lv": 2,
          "k": "vs",
          "tab": "程度还是样子",
          "say": [
            "他跑得很快。——“很快”描写跑的样子，可以问：跑得怎么样？这叫状态补语。",
            "今天热得很。——“很”只说热的程度，换成“很热”意思差不多。这是程度补语。",
            "程度补语前面多是形容词或心理动词，如热、高兴、喜欢。"
          ],
          "ex": [
            {
              "s": "今天热得很。≈ 今天很热。",
              "ok": true,
              "is": true
            },
            {
              "s": "他跑得很快。",
              "ok": true,
              "is": false,
              "note": "状态补语"
            }
          ],
          "act": [
            "上下两句，停 4 秒",
            "上句“得很”挪到前面变“很热”→意思不变",
            "下句试着挪成“很跑快”→灰掉（不能这样挪），标“描写样子”"
          ]
        },
        {
          "lv": 2,
          "k": "fix",
          "tab": "“极了”不带“得”",
          "say": [
            "“极了”直接贴在形容词后面，中间不加“得”。",
            "他高兴得极了——不对。他高兴极了——对。“得很”才要带“得”。"
          ],
          "ex": [
            {
              "s": "他高兴得极了。",
              "ok": false,
              "fix": "他高兴极了。",
              "why": "“极了”前不加“得”。"
            },
            {
              "s": "他高兴得很。",
              "ok": true
            }
          ],
          "act": [
            "错句停 4 秒→✗，错色圈住“得”",
            "“得”淡出，合拢",
            "对照句“高兴得很”出现→✓"
          ]
        },
        {
          "lv": 3,
          "k": "vs",
          "tab": "两个“坏了”",
          "say": [
            "想一想：“小狗累坏了”和“杯子摔坏了”，两个“坏了”意思一样吗？",
            "杯子摔坏了：杯子真的坏了，“坏”是结果，叫结果补语。",
            "小狗累坏了：小狗没有坏，只是累到了极点，“坏了”说的是程度，叫程度补语。",
            "同一个词，在不同的动词后面，可以做不同的补语。"
          ],
          "ex": [
            {
              "s": "小狗累坏了。",
              "ok": true
            },
            {
              "s": "杯子摔坏了。",
              "ok": true
            }
          ],
          "ask": "两个“坏了”一样吗？",
          "src": "刘月华、潘文娱、故韡《实用现代汉语语法》（增订本），商务印书馆 2001，「程度补语」「结果补语」",
          "act": [
            "两句并排，停 4 秒",
            "“杯子摔坏了”下方两格状态图：完整→碎了",
            "“小狗累坏了”下方状态图：小狗还是小狗，只有一根程度条涨满"
          ]
        },
        {
          "lv": 2,
          "k": "review",
          "huilian": true,
          "tab": "改对了吗",
          "say": [
            "题目：改正“今天的作业多得很多”。",
            "这位同学改成：今天的作业很多得很。改对了吗？"
          ],
          "task": "改正“今天的作业多得很多”",
          "answer": "今天的作业很多得很。",
          "ok": false,
          "good": "今天的作业多得很。（或：今天的作业多极了。）",
          "rule": "程度说一次就够：“得很”已经表示程度高，前后不能再加“很”。",
          "act": [
            "题目卡 + 同学答案卡→✗，错色圈住前面的“很”",
            "“很”淡出",
            "写出两种正确说法"
          ]
        }
      ],
      "pitfalls": [
        "“极了”前不加“得”：✗高兴得极了。",
        "程度说重复：✗很多得很。",
        "“跑得很快”在不少教材里也叫程度补语；本稿按刘月华等叫状态补语，讲课时要说明两种叫法。"
      ],
      "status": "草稿"
    },
    {
      "id": "bu_shiliang",
      "group": "补语细分",
      "title": {
        "term": "时量补语",
        "kid": "做了多长时间"
      },
      "core": "动词后面用表示一段时间的词语（一会儿、三天、两个小时）补充说明动作持续了多久，或者动作完成后过了多久。",
      "tpl": [
        "line",
        "fix",
        "vs",
        "review"
      ],
